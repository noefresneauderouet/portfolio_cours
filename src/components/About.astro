---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="container-x">
    <SectionHeading index="01" eyebrow={t.about.eyebrow} title={t.about.title} />

    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div data-reveal class="space-y-5 text-[15px] leading-relaxed text-muted sm:text-base">
        <p data-reveal-child class="text-body">{t.about.p1}</p>
        <p data-reveal-child>{t.about.p2}</p>
        <p data-reveal-child>{t.about.p3}</p>

        <div data-reveal-child class="pt-4">
          <p class="text-[11px] tracking-[0.24em] text-faint uppercase">{t.about.softTitle}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              t.about.soft.map((skill) => (
                <li class="rounded-full border border-line bg-white/[0.03] px-3.5 py-1.5 text-[13px] text-body">
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal class="space-y-6">
        <div
          data-avatar
          class="group relative aspect-[4/5] overflow-hidden rounded-[24px] border border-line bg-surface"
        >
          <div
            class="absolute inset-0 bg-linear-to-br from-violet/25 via-transparent to-cyan/20"
            aria-hidden="true"
          >
          </div>

          <img
            src={profile.photo}
            alt={t.about.photoAlt}
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
            onerror="this.closest('[data-avatar]').classList.add('is-fallback')"
            class="relative h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-[1.04] group-hover:grayscale-0"
          />

          <div
            data-monogram
            class="absolute inset-0 hidden place-items-center bg-linear-to-br from-surface to-ink"
            aria-hidden="true"
          >
            <span class="font-display text-7xl font-bold text-gradient">{profile.initials}</span>
          </div>

          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-ink to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>

        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line">
          {
            t.about.facts.map((fact) => (
              <div class="bg-ink-2 px-4 py-4">
                <dt class="text-[10px] tracking-[0.2em] text-faint uppercase">{fact.label}</dt>
                <dd class="mt-1.5 text-sm font-medium text-body">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
