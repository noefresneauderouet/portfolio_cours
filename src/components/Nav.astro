---
import { useTranslations, alternateHref, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#skills', label: t.nav.skills },
  { href: '#projects', label: t.nav.projects },
  { href: '#path', label: t.nav.path },
  { href: '#contact', label: t.nav.contact },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-stuck]:backdrop-blur-xl [&.is-stuck]:bg-ink/70 [&.is-stuck]:border-b [&.is-stuck]:border-line"
>
  <nav class="container-x flex h-18 items-center justify-between gap-4" aria-label={t.nav.menu}>
    <a
      href={lang === 'fr' ? '/' : '/en/'}
      class="group flex items-center gap-2.5"
      aria-label={`${profile.firstName} ${profile.lastName}`}
    >
      <span
        class="relative grid h-9 w-9 place-items-center rounded-xl bg-linear-to-br from-violet to-cyan text-[11px] font-bold tracking-tight text-white shadow-lg shadow-violet/25 transition-transform duration-500 group-hover:rotate-6 group-hover:scale-105"
      >
        {profile.initials}
      </span>
      <span class="hidden text-sm font-medium tracking-tight text-body sm:block">
        {profile.firstName}<span class="text-faint"> / dev</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link
              class="relative rounded-full px-3.5 py-2 text-sm text-muted transition-colors duration-300 hover:text-body"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={alternateHref(lang)}
        title={t.meta.langTitle}
        class="rounded-full border border-line px-3 py-1.5 text-xs font-semibold tracking-wide text-muted transition-colors duration-300 hover:border-line-strong hover:text-body"
      >
        {t.meta.langLabel}
      </a>

      <a
        href={profile.cv}
        download
        class="hidden rounded-full border border-line-strong bg-white/5 px-4 py-1.5 text-xs font-semibold text-body transition-colors duration-300 hover:bg-white/10 sm:block"
      >
        {t.nav.cv}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.menu}
        class="grid h-9 w-9 place-items-center rounded-xl border border-line text-body transition-colors duration-300 hover:border-line-strong md:hidden"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h10" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu-panel
    class="pointer-events-none absolute inset-x-0 top-full -translate-y-2 border-b border-line bg-ink/95 px-5 pb-8 pt-2 opacity-0 backdrop-blur-xl transition-all duration-300 md:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map((link, index) => (
          <li class="border-b border-line/60 last:border-0">
            <a
              href={link.href}
              class="flex items-baseline gap-3 py-3.5 font-display text-xl tracking-tight text-body"
            >
              <span class="font-sans text-[11px] tabular-nums text-faint">
                0{index + 1}
              </span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={profile.cv}
      download
      class="mt-5 block rounded-full bg-linear-to-r from-violet to-cyan px-5 py-3 text-center text-sm font-semibold text-white"
    >
      {t.contact.cvCta}
    </a>
  </div>
</header>
