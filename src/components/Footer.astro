---
import { useTranslations, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-line py-10">
  <div class="container-x flex flex-col items-center justify-between gap-6 sm:flex-row">
    <div class="text-center sm:text-left">
      <p class="text-[13px] text-muted">
        © {year} · {t.footer.built}
      </p>
      <p class="mt-1 text-[12px] text-faint">{t.footer.stack}</p>
    </div>

    <div class="flex items-center gap-5">
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
        class="text-muted transition-colors hover:text-body"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        class="text-muted transition-colors hover:text-body"
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M3.6 16H.3V5.3h3.3V16ZM1.9 3.9C.9 3.9 0 3 0 1.9 0 .9.9 0 1.9 0c1.1 0 1.9.9 1.9 1.9 0 1.1-.8 2-1.9 2ZM16 16h-3.3v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.4-2 2.7V16H5.7V5.3h3.2v1.5h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5V16Z"
          ></path>
        </svg>
      </a>

      <a
        href={`mailto:${profile.email}`}
        aria-label="E-mail"
        class="text-muted transition-colors hover:text-body"
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect
            x="1.5"
            y="3.5"
            width="17"
            height="13"
            rx="2.5"
            stroke="currentColor"
            stroke-width="1.5"></rect>
          <path
            d="m2.5 5.5 6.4 5a1.8 1.8 0 0 0 2.2 0l6.4-5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </a>

      <a
        href="#hero"
        class="ml-1 rounded-full border border-line px-3.5 py-1.5 text-[12px] text-muted transition-colors hover:border-line-strong hover:text-body"
      >
        ↑ {t.footer.top}
      </a>
    </div>
  </div>
</footer>
