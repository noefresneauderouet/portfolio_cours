---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { index, eyebrow, title, subtitle } = Astro.props;
---

<div data-reveal class="mb-14 max-w-2xl">
  <div class="flex items-center gap-4">
    <span class="font-display text-xs font-semibold tabular-nums text-violet">{index}</span>
    <span class="text-[11px] tracking-[0.28em] text-faint uppercase">{eyebrow}</span>
    <span class="h-px flex-1 bg-linear-to-r from-line-strong to-transparent"></span>
  </div>

  <h2 class="mt-5 font-display text-[clamp(1.9rem,5.2vw,3.4rem)] leading-[1.02] font-bold">
    {title}
  </h2>

  {subtitle && <p class="mt-4 text-[15px] leading-relaxed text-muted">{subtitle}</p>}
</div>
